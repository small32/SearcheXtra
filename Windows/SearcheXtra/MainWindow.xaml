<Window x:Class="SearcheXtra.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:SearcheXtra.Windows" Title="SearcheXtra">
 <Grid x:Name="Root" Background="{ThemeResource Ground}" KeyboardAcceleratorPlacementMode="Hidden">
  <Grid.Resources><ResourceDictionary>
  <Style x:Key="Quiet" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{ThemeResource Ink}"/><Setter Property="Padding" Value="4"/><Setter Property="MinWidth" Value="26"/><Setter Property="MinHeight" Value="26"/><Setter Property="CornerRadius" Value="6"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="TabRow" TargetType="ListViewItem"><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,0"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="TabPlate" CornerRadius="7" Background="Transparent"><VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="TabPlate.Background" Value="{ThemeResource Wash}"/></VisualState.Setters></VisualState><VisualState x:Name="Selected"><VisualState.Setters><Setter Target="TabPlate.Background" Value="{ThemeResource Wash}"/></VisualState.Setters></VisualState><VisualState x:Name="SelectedPointerOver"><VisualState.Setters><Setter Target="TabPlate.Background" Value="{ThemeResource Hairline}"/></VisualState.Setters></VisualState><VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="TabPlate.Background" Value="{ThemeResource Hairline}"/></VisualState.Setters></VisualState><VisualState x:Name="SelectedPressed"><VisualState.Setters><Setter Target="TabPlate.Background" Value="{ThemeResource Hairline}"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="TopTabRow" TargetType="ListViewItem" BasedOn="{StaticResource TabRow}"><Setter Property="Width" Value="186"/></Style>
  <Style x:Key="TabAddressText" TargetType="TextBox">
   <Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{ThemeResource Ink}"/><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Grid Background="Transparent">
     <ScrollViewer x:Name="ContentElement" IsTabStop="False" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" ZoomMode="Disabled"/>
     <TextBlock x:Name="PlaceholderTextContentPresenter" Text="{TemplateBinding PlaceholderText}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" Opacity="0.55" IsHitTestVisible="False"/>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="TabContent" x:DataType="local:BrowserTab"><Grid Height="28" ColumnSpacing="8" Background="Transparent" Tag="{x:Bind}" PointerPressed="TabBody_PointerPressed" Tapped="TabBody_Tapped"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="TabLetter" Text="{x:Bind LetterDisplay, Mode=OneWay}" FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
   <Image x:Name="TabFavicon" Source="{x:Bind local:MainWindow.Icon(Favicon), Mode=OneWay}" Width="14" Height="14"/>
   <Button x:Name="TabSiteInfo" Style="{StaticResource Quiet}" Width="20" Height="22" MinWidth="0" MinHeight="0" Padding="2" Visibility="Collapsed" Click="SiteInfo_Click"/>
   <TextBlock x:Name="TabLabel" Grid.Column="1" Text="{x:Bind Label, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
   <Grid x:Name="TabAddressHost" Grid.Column="1" Visibility="Collapsed"/><Button x:Name="TabClose" Grid.Column="2" Style="{StaticResource Quiet}" Content="×" MinWidth="16" MinHeight="16" Width="16" Height="20" Padding="0" Opacity="0" Tag="{x:Bind}" Click="TabCross_Click"/>
   <ProgressBar Grid.ColumnSpan="3" Value="{x:Bind Reading, Mode=OneWay}" Height="1" MinHeight="1" Maximum="100" VerticalAlignment="Bottom" Foreground="#A0A0A0" Background="Transparent" Opacity="0.35" IsHitTestVisible="False"/>
  </Grid></DataTemplate>
  </ResourceDictionary></Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="Toolbar" Height="48" Background="Transparent">
   <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition x:Name="CaptionInset" Width="138"/></Grid.ColumnDefinitions>
   <Border x:Name="TitleAppIcon" Width="24" Height="24" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.Name="SearcheXtra">
    <Border.Background><ImageBrush ImageSource="ms-appx:///Assets/AppIcon.png" Stretch="Uniform"/></Border.Background>
   </Border>
   <Grid Grid.Column="1" x:Name="TopStrip" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
    <ListView x:Name="TopTabs" CanDragItems="True" CanReorderItems="True" AllowDrop="True" DragItemsCompleted="Tabs_DragCompleted" SelectionChanged="TopTabs_SelectionChanged" ItemTemplate="{StaticResource TabContent}" ItemContainerStyle="{StaticResource TopTabRow}" ContainerContentChanging="TabContainer_Changed" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center"><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel></ListView>
    <Button x:Name="TopNew" Grid.Column="1" Style="{StaticResource Quiet}" Content="+" Click="NewTab_Click" VerticalAlignment="Center"/>
   </Grid>
   <StackPanel x:Name="Helm" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="8,0,10,0">
    <Button x:Name="BackButton" Style="{StaticResource Quiet}" Content="‹" FontSize="22" Click="Back_Click"/><Button x:Name="ForwardButton" Style="{StaticResource Quiet}" Content="›" FontSize="22" Click="Forward_Click"/><Button x:Name="ReloadButton" Style="{StaticResource Quiet}" Content="↻" FontSize="18" Click="Reload_Click"/>
    <Button x:Name="HomeButton" Style="{StaticResource Quiet}" Content="⌂" Click="Home_Click"/>
    <Button x:Name="ReopenButton" Style="{StaticResource Quiet}" Content="↶" Click="Reopen_Click"/>
    <Button x:Name="DownloadsButton" Style="{StaticResource Quiet}" Content="↓" Visibility="Collapsed" Click="Downloads_Click"/>
   </StackPanel>
   <StackPanel x:Name="TitleActions" Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,4,0">
    <StackPanel x:Name="PinnedExtensions" Orientation="Horizontal" Spacing="2"/>
    <Button x:Name="ExtensionsButton" Style="{StaticResource Quiet}" Content="◇" Click="Extensions_Click" ToolTipService.ToolTip="Extensions"/>
    <Button x:Name="TopSettings" Style="{StaticResource Quiet}" Content="☷" Click="Settings_Click" ToolTipService.ToolTip="Settings"/>
   </StackPanel>
  </Grid>
  <ScrollViewer x:Name="BookmarkScroller" Grid.Row="1" MinHeight="28" Background="Transparent" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled"><StackPanel x:Name="BookmarkRow" Background="Transparent" Orientation="Horizontal" Spacing="2" Padding="10,2"/></ScrollViewer>
  <Grid Grid.Row="2" x:Name="Body"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="0"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="RightSidebarColumn" Width="0"/></Grid.ColumnDefinitions>
   <Grid x:Name="Sidebar" Visibility="Collapsed" Padding="10,0" BorderBrush="{ThemeResource Hairline}" BorderThickness="0,0,1,0">
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Grid x:Name="SidebarHeader" Background="Transparent"/>
    <Grid Grid.Row="1" x:Name="PinRow" Margin="0,0,0,8"/>
    <StackPanel Grid.Row="2"><ListView x:Name="SideTabs" CanDragItems="True" CanReorderItems="True" AllowDrop="True" DragItemsCompleted="Tabs_DragCompleted" SelectionChanged="SideTabs_SelectionChanged" ItemTemplate="{StaticResource TabContent}" ItemContainerStyle="{StaticResource TabRow}" ContainerContentChanging="TabContainer_Changed"/><Button x:Name="SideNew" Style="{StaticResource Quiet}" Content="+  New tab" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NewTab_Click"/></StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4"><Button x:Name="SettingsButton" Style="{StaticResource Quiet}" Content="☷" Click="Settings_Click" ToolTipService.ToolTip="Settings"/><Button x:Name="SpacesButton" Style="{StaticResource Quiet}" Content="Default" Click="Spaces_Click"/><Button x:Name="MenuButton" Style="{StaticResource Quiet}" Content="···" Click="Menu_Click"/></StackPanel>
   </Grid>
   <Grid x:Name="PageArea" Grid.Column="1"><Grid x:Name="Pages"/><Grid x:Name="Welcome"/>
    <ProgressBar x:Name="LoadingBar" VerticalAlignment="Top" Height="2" IsIndeterminate="True" Visibility="Collapsed" IsHitTestVisible="False"/>
    <TextBlock x:Name="Status" FontSize="11" Margin="12,2" Opacity="0.65" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
    <Grid x:Name="AddressParking" Visibility="Collapsed"><TextBox x:Name="Address" Style="{StaticResource TabAddressText}" PlaceholderText="URL / Search" TextChanged="Address_Changed" KeyDown="Address_KeyDown"/></Grid>
   </Grid>
  </Grid>
  <Grid x:Name="OverlayLayer" Grid.RowSpan="3" Visibility="Collapsed" Background="#50000000" Tapped="OverlayBackdrop_Tapped"/>
 </Grid>
</Window>
